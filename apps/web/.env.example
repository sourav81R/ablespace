# ---------------------------------------------------------------------------
# AbleSpace web client — environment template
#
# Copy to `.env.local` and fill in real values:
#   cp apps/web/.env.example apps/web/.env.local
# ---------------------------------------------------------------------------

# Base URL of the NestJS API, including its route prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Firebase web configuration
#
# From: Firebase Console > Project Settings > General > Your apps > Web app.
#
# These are PUBLIC by design — they ship to the browser in every Firebase app
# and identify the project rather than authorise access. Security comes from
# Firebase Auth rules and from the API verifying every ID token server-side.
#
# Do NOT put the Admin service-account key here. That one is a real secret and
# belongs only in the API's own .env.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
