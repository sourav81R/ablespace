{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "strictPropertyInitialization": false,

    // Ambient type packages available to every file in this project.
    //
    // Declared explicitly rather than left to automatic @types discovery: this
    // is the config an editor loads for a .spec.ts file, and without `jest`
    // here the language server reports `describe`, `it` and `expect` as
    // undefined even though the command-line typecheck passes.
    "types": ["node", "jest"],

    // Resolve the shared package to its compiled output rather than its source.
    // Pointing at src/ would pull files outside this project's rootDir into the
    // build and produce a nested dist/apps/api/src/ layout, breaking start:prod.
    "paths": {
      "@ablespace/shared": ["../../packages/shared/dist"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
