# ---------------------------------------------------------------------------
# AbleSpace API — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api

# MongoDB connection string (MongoDB Atlas or local).
# Include the database name in the path, e.g. .../ablespace?retryWrites=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ablespace?retryWrites=true&w=majority

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase Admin SDK — SERVER-SIDE SECRETS
# ---------------------------------------------------------------------------
# These three values come from the service-account JSON:
#   Firebase Console > Project Settings > Service Accounts >
#   "Generate new private key"
#
# The downloaded JSON contains "project_id", "client_email" and "private_key".
# Copy each into the matching variable below.
#
# NEVER expose these to the browser. They can mint tokens for any user in the
# project. The web client uses the separate, public Firebase web config
# (apiKey, authDomain, ...) instead — that one is safe to ship to the browser.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# The PEM private key, on ONE line, with newlines written as the two characters
# \ and n. Wrap it in double quotes so the .env parser keeps them intact:
#
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# Most hosting providers cannot store a real newline in an environment
# variable, so the key is stored escaped and converted back at boot.
# Copying the "private_key" value straight out of the JSON file already gives
# you this escaped form.
FIREBASE_PRIVATE_KEY=

# Rate limiting (requests per TTL window, per IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
