# ---------------------------------------------------------------------------
# AbleSpace API — environment template
#
# Copy to `.env` and fill in real values:
#   cp apps/api/.env.example apps/api/.env
#
# NEVER commit `.env`. It is gitignored, along with any service-account JSON.
# Every value below is validated at boot, so a misconfigured deployment fails
# immediately rather than at the first request that needs the missing value.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Prefix applied to every route, e.g. /api/tasks
API_PREFIX=api

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas or a local server. Include the database name in the path —
# without it the driver silently uses "test".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ablespace?retryWrites=true&w=majority

# If the mongodb+srv:// form fails with "querySrv ECONNREFUSED" or
# "querySrv ENOTFOUND", the network is blocking DNS SRV lookups. Use the direct
# form instead: it lists the shard hosts explicitly and supplies the values the
# SRV TXT record would have provided. Functionally identical.
#
# Find the hosts and replica set name with:
#   nslookup -type=SRV _mongodb._tcp.<cluster>.mongodb.net
#   nslookup -type=TXT <cluster>.mongodb.net
#
# MONGODB_URI=mongodb://<username>:<password>@<shard-00-00>:27017,<shard-00-01>:27017,<shard-00-02>:27017/ablespace?ssl=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# The browser origin allowed to call this API. Accepts a comma-separated list
# when more than one is needed, e.g. a production and a preview domain:
#   CORS_ORIGIN=https://app.example.com,https://preview.example.com
#
# "*" is rejected in production, and production refuses to start when this is
# unset — an unreachable API is safer than one any site can call.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase Admin SDK — SERVER-SIDE SECRETS
# ---------------------------------------------------------------------------
# From the service-account JSON:
#   Firebase Console > Project Settings > Service Accounts >
#   "Generate new private key"
#
# Copy "project_id", "client_email" and "private_key" from that file.
#
# NEVER expose these to the browser: the private key can mint tokens for any
# user in the project. The web client uses the separate, public Firebase web
# config (apiKey, authDomain, ...), which is safe to ship to the browser.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# The PEM private key on ONE line, in double quotes, with newlines written as
# the two characters \ and n:
#
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# Copying the "private_key" value straight out of the JSON already gives you
# this escaped form. Most hosting providers cannot store a real newline in an
# environment variable, which is why it is stored escaped and converted back
# at boot.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Rate limiting (per IP)
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
