# ---------------------------------------------------------------------------
# AbleSpace API — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api

# MongoDB connection string (MongoDB Atlas or local).
# Include the database name in the path, e.g. .../ablespace?retryWrites=true
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ablespace?retryWrites=true&w=majority

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase Admin SDK
# ---------------------------------------------------------------------------
# Download from: Firebase Console > Project Settings > Service Accounts >
# "Generate new private key". Then base64-encode the whole JSON file:
#   Linux/macOS : base64 -w0 service-account.json
#   PowerShell  : [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Base64 is used because the private key contains newlines, which most hosting
# providers' environment-variable UIs mangle.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Your Firebase project id. Must match the service account's project.
FIREBASE_PROJECT_ID=

# Rate limiting (requests per TTL window, per IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
